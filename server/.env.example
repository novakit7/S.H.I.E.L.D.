PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shield
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# OpenRouter Configuration
OPEN_ROUTER_API_KEY=your_open_router_api_key
OPEN_ROUTER_MODEL=gpt-5.5
OPEN_ROUTER_MAX_OUTPUT_TOKENS=600
OPEN_ROUTER_TIMEOUT=30000
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

MAIL_FROM_NAME=S.H.I.E.L.D.
MAIL_FROM_EMAIL=your-email@gmail.com

# Gmail requires an App Password when two-step verification is enabled.
# Do not use your normal Gmail password.

# Optional first administrator account. Use a unique, strong password and keep it out of source control.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Campus Administrator
BOOTSTRAP_ADMIN_DEPARTMENT=Student Affairs
BOOTSTRAP_ADMIN_STUDENT_ID=administrator
